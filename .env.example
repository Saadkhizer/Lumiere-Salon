# Copy this file to .env.local and fill in your Supabase project values.
# Settings → API in your Supabase dashboard.
# Both are PUBLIC (safe in the browser) — never put the service_role key here.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Optional — LOCAL DEV ONLY. Pre-fills the /admin/login form so you can just
# click "Sign in". Create this user in Supabase → Authentication → Users first.
# ⚠️ Do NOT set NEXT_PUBLIC_ADMIN_PASSWORD on a public deploy — it would be
#    visible in the browser. Leave it unset in production.
NEXT_PUBLIC_ADMIN_EMAIL=admin@yoursalon.pk
NEXT_PUBLIC_ADMIN_PASSWORD=Saad@1234
